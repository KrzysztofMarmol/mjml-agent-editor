{
  "name": "@mjml-agent-editor/editor",
  "version": "0.1.8",
  "description": "React MJML editor with an agent chat panel and canvas comments.",
  "keywords": [
    "mjml",
    "email-editor",
    "grapesjs",
    "react",
    "ai-agent",
    "comments"
  ],
  "license": "MIT",
  "author": "Krzysztof Marmol",
  "homepage": "https://github.com/KrzysztofMarmol/mjml-agent-editor/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/KrzysztofMarmol/mjml-agent-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrzysztofMarmol/mjml-agent-editor.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js",
      "require": "./dist/canvas.cjs"
    },
    "./styles.css": "./src/components/editor/editor-theme.css"
  },
  "files": [
    "dist",
    "src/components/editor/editor-theme.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.232",
    "@grapesjs/react": "^2.0.0",
    "@mjml-agent-editor/core": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grapesjs": "^0.22.16",
    "grapesjs-mjml": "^1.0.8",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "ai": "^6.0.230"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "ai": "^6.0.230"
  }
}
