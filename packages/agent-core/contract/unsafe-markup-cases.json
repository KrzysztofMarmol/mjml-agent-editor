[
  {
    "name": "a script link",
    "html": "<a href=\"javascript:alert(1)\">x</a>",
    "expected": ["javascript:alert(1)"]
  },
  {
    "name": "a link hidden behind a quoted attribute",
    "html": "<a title=' href=\"https://good' href=\"javascript:alert(1)\">Go</a>",
    "expected": ["javascript:alert(1)"]
  },
  {
    "name": "an attribute that only mentions a link",
    "html": "<a title='mentions href=javascript:x'>t</a>",
    "expected": []
  },
  {
    "name": "a slash for a space",
    "html": "<a/href=vbscript:y>y</a>",
    "expected": ["vbscript:y"]
  },
  {
    "name": "an unquoted value with a stray quote",
    "html": "<a href=javascript:alert(1)//'>x</a>",
    "expected": ["javascript:alert(1)//'"]
  },
  {
    "name": "an event handler",
    "html": "<img src=\"x\" onerror=\"alert(1)\">",
    "expected": ["onerror"]
  },
  {
    "name": "a frame, in any case",
    "html": "<IFRAME src=\"javascript:x\"></IFRAME>",
    "expected": ["<iframe>"]
  },
  {
    "name": "an animation that sets a link",
    "html": "<svg><animate attributeName=\"href\" values=\"javascript:alert(1)\"/></svg>",
    "expected": ["<svg>", "<animate>"]
  },
  {
    "name": "a link inside a comment, as Outlook reads conditional markup",
