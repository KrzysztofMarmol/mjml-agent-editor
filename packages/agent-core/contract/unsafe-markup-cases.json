    "expected": ["&#106;avascript:x"]
  },
  {
    "name": "a tab inside the scheme",
    "html": "<a href=\"java&#x09;script:x\">x</a>",
    "expected": ["java&#x09;script:x"]
  },
  {
    "name": "a reference out of Unicode's range",
    "html": "<a href=\"https://good/&#99999999;\">x</a><a href=\"&#x110000;\">y</a>",
    "expected": []
  },
  {
    "name": "a letter that only looks like ASCII",
    "html": "<a href=\"Kavascript:x\">x</a><a href=\"ſcript:x\">y</a>",
    "expected": []
  },
  {
    "name": "safe links and plain text",
    "html": "<p>a < b</p><a href=\"mailto:a@b.c\">m</a><a href=\"tel:+48\">t</a><a href=\"{{unsubscribe}}\">u</a><a href=\"#top\">t</a>",
    "expected": []
  },
  {
    "name": "a quote left open swallows the rest, as in a browser",
    "html": "<a title=\"x><a href=\"javascript:x\">y</a>",
    "expected": []
