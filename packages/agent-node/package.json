{
  "name": "@mjml-agent-editor/agent-node",
  "version": "0.1.6",
  "description": "TypeScript implementation of the MJML editing agent: tools, system prompt and chat handler.",
  "keywords": [
    "mjml",
    "email",
    "ai-agent",
    "vercel-ai-sdk",
    "nextjs",
    "route-handler"
  ],
  "license": "MIT",
  "author": "Krzysztof Marmol",
  "homepage": "https://github.com/KrzysztofMarmol/mjml-agent-editor/tree/main/packages/agent-node#readme",
  "bugs": {
    "url": "https://github.com/KrzysztofMarmol/mjml-agent-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrzysztofMarmol/mjml-agent-editor.git",
    "directory": "packages/agent-node"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.90",
    "@mjml-agent-editor/core": "workspace:*",
    "mjml": "^4.18.0"
  },
  "peerDependencies": {
    "ai": "^6.0.230"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.14",
    "@types/mjml": "^4.7.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ai": "^6.0.230"
  }
}
