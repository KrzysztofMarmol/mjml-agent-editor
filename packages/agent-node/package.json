{
  "name": "@mjml-agent-editor/agent-node",
  "version": "0.0.0",
  "description": "TypeScript implementation of the MJML editing agent: tools, system prompt and chat handler.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@mjml-agent-editor/core": "workspace:*",
    "ai": "^6.0.230",
    "mjml": "^4.18.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.14",
    "@types/mjml": "^4.7.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
