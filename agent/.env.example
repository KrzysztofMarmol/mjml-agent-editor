# ── Agent LLM backend (Vercel AI SDK for Python) ─────────────────────────────
# Pick a backend with AGENT_PROVIDER: anthropic (default) | deepseek | gemini
# (or a custom OpenAI-compatible one). Fill in the matching API key below.
AGENT_PROVIDER=anthropic

# anthropic (default) — paid API
ANTHROPIC_API_KEY=
# AGENT_MODEL=anthropic:claude-sonnet-5

# deepseek — 5M free tokens on signup, then very cheap. Key: platform.deepseek.com
# AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# AGENT_MODEL=deepseek-chat            # default; deepseek-reasoner also available

# gemini — free tier (1500 req/day, no card). Key: aistudio.google.com/apikey
# AGENT_PROVIDER=gemini
GEMINI_API_KEY=
# AGENT_MODEL=gemini-2.5-flash         # default (free-tier, tool calling)

# custom OpenAI-compatible backend (NVIDIA NIM, OpenRouter, Qwen, GLM, …):
# AGENT_PROVIDER=custom
# AGENT_BASE_URL=https://…/v1
# AGENT_MODEL=…
# AGENT_API_KEY=…

# Image generation (OpenAI)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# Supabase — values from `npx supabase status` (local stack)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional: path to the mjml binary (default: web/node_modules/.bin/mjml)
# MJML_BIN=
