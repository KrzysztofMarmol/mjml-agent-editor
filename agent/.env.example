# Agent LLM model (Vercel AI SDK Python, provider:model)
AGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=

# Image generation (OpenAI)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# Supabase — values from `npx supabase status` (local stack)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional: path to the mjml binary (default: web/node_modules/.bin/mjml)
# MJML_BIN=
