# Model LLM agenta (Vercel AI SDK Python, provider:model)
AGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=

# Generowanie obrazów (OpenAI)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# Supabase — wartości z `npx supabase status` (lokalny stack)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Opcjonalnie: ścieżka do binarki mjml (domyślnie web/node_modules/.bin/mjml)
# MJML_BIN=
