{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Turborepo runs tasks in strict env mode: a variable the shell exports is invisible
      // to the task unless it is listed here. `apps/example` builds its Supabase clients and
      // agent handler at module scope, so Next.js collecting page data for /api/chat throws
      // on a missing variable rather than deferring it to request time.
      // `NEXT_PUBLIC_*` is not listed: Turborepo infers it from the Next.js framework.
      "env": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AGENT_PROVIDER",
        "AGENT_MODEL",
        "AGENT_BASE_URL",
        "AGENT_API_KEY",
        "ANTHROPIC_API_KEY",
        "DEEPSEEK_API_KEY",
        "GEMINI_API_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    // agent-node alone also needs its *own* build: the CLI test runs the built binary in a
    // real Node process, because what it checks is module resolution and a test runner
    // resolves modules itself. Scoped to this package rather than added to `test` above,
    // which would pull every workspace build — including the example app, whose build wants
    // Supabase and provider credentials — into `pnpm test`.
    "@mjml-agent-editor/agent-node#test": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
