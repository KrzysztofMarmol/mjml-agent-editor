# ── Agent LLM backend (Vercel AI SDK for Python) ─────────────────────────────
# AGENT_PROVIDER picks the backend: anthropic (default) | deepseek | gemini, or any
# other value for a custom OpenAI-compatible endpoint. Fill in the matching key.
AGENT_PROVIDER=anthropic

# anthropic (default) — paid API
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic:claude-haiku-4-5

# deepseek — 5M free tokens on signup, then very cheap. Key: platform.deepseek.com
# AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# AGENT_MODEL=deepseek-chat            # default; deepseek-reasoner also available

# gemini — free tier (1500 req/day, no card). Key: aistudio.google.com/apikey
# AGENT_PROVIDER=gemini
GEMINI_API_KEY=
# AGENT_MODEL=gemini-2.5-flash         # default (free tier, supports tool calling)

# custom OpenAI-compatible backend (NVIDIA NIM, OpenRouter, Qwen, GLM, …)
# AGENT_PROVIDER=custom
# AGENT_BASE_URL=https://…/v1
# AGENT_MODEL=…
# AGENT_API_KEY=…

# Image generation. "placeholder" (default) never calls a paid API; "generate" uses
# OpenAI. The spike inferred this from a missing OPENAI_API_KEY, so a misconfigured
# deployment silently started paying for the most expensive call in the system.
IMAGE_MODE=placeholder
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# Supabase — values from `npx supabase status` (local stack)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Origins allowed to call this service, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# The mjml v4 CLI. Required: MRML (the Rust port available as a Python package) performs
# no validation at all, so it cannot enforce "never save a document that does not
# compile". Leave unset to take the first `mjml` on PATH (`npm install -g mjml`).
# MJML_BIN=

# The shared tool contract, emitted by `pnpm --filter @mjml-agent-editor/core build`.
# Defaults to ../packages/agent-core/contract/tools.json.
# TOOLS_CONTRACT_PATH=
