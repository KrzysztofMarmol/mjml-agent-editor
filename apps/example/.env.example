# Local Supabase — `npx supabase status` prints these.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# The agent's model. Haiku is the demo default: cheapest of the current models and
# more than capable of section-level MJML edits.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5

# Where this dev server listens, and which origin may call it. Both exist only because
# the frontend is still a separate app; once it is a Next.js route handler the agent is
# same-origin and neither is needed.
PORT=8001
ALLOWED_ORIGIN=http://localhost:3000
