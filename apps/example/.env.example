# Server-only. Never exposed to the browser: the route handler is the sole reader.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# The agent's model. Haiku is the default: cheapest of the current models and more than
# capable of section-level MJML edits.
AGENT_MODEL=claude-haiku-4-5

# Browser-visible. `npx supabase status` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
