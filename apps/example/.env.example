# Server-only. Never exposed to the browser: the route handler is the sole reader.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Agent LLM backend ────────────────────────────────────────────────────────
# AGENT_PROVIDER picks the backend: anthropic (default) | deepseek | gemini, or any
# other value for a custom OpenAI-compatible endpoint. Fill in the matching key.
AGENT_PROVIDER=anthropic

# anthropic (default) — paid API. Haiku is cheapest of the current models and more than
# capable of section-level MJML edits.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5

# deepseek — 5M free tokens on signup, then very cheap. Key: platform.deepseek.com
# AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# AGENT_MODEL=deepseek-chat            # default; deepseek-reasoner also available

# gemini — free tier (1500 req/day, no card). Key: aistudio.google.com/apikey
# AGENT_PROVIDER=gemini
GEMINI_API_KEY=
# AGENT_MODEL=gemini-2.5-flash         # default (free tier, supports tool calling)

# custom OpenAI-compatible backend (NVIDIA NIM, OpenRouter, Qwen, GLM, …)
# AGENT_PROVIDER=custom
# AGENT_BASE_URL=https://…/v1
# AGENT_MODEL=…
# AGENT_API_KEY=…

# Browser-visible. `npx supabase status` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
